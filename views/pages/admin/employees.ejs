<%- include('../../partials/header', { title: 'Manage Employees', user: user }) %>

<div class="page-wrapper">
  <div class="container-fluid">
    <h3>👷 Employees List</h3>

    <table class="table table-striped mt-3">
      <thead>
        <tr>
          <th>Name</th>
          <th>Email</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% employees.forEach(e => { %>
        <tr>
          <td><%= e.name %></td>
          <td><%= e.email %></td>
          <td>
            <form action="/admin/delete-user/<%= e._id %>" method="get" style="display:inline;">
              <button class="btn btn-danger btn-sm">Delete</button>
            </form>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>

    <h4 class="mt-5">➕ Add Employee</h4>
    <form action="/admin/add-user" method="POST" class="mt-3">
      <input type="hidden" name="role" value="employee">
      <div class="row">
        <div class="col-md-4">
          <input type="text" name="name" placeholder="Name" class="form-control" required>
        </div>
        <div class="col-md-4">
          <input type="email" name="email" placeholder="Email" class="form-control" required>
        </div>
        <div class="col-md-3">
          <input type="password" name="password" placeholder="Password" class="form-control" required>
        </div>
        <div class="col-md-1">
          <button class="btn btn-primary w-100">Add</button>
        </div>
      </div>
    </form>
  </div>
</div>

<%- include('../../partials/footer') %>
