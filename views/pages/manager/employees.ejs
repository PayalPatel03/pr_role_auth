<%- include('../../partials/header', { title: 'My Team' , user: user }) %>

    <div class="page-wrapper">
        <div class="container-fluid">
            <h3>👥 My Employees</h3>

            <table class="table table-striped mt-3 table-active table-bordered table-light table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% employees.forEach(emp=> { %>
                        <tr>
                            <td>
                                <%= emp.name %>
                            </td>
                            <td>
                                <%= emp.email %>
                            </td>
                            <td>
                                <!-- 🗑 Delete Button -->
                                <form action="/manager/delete-employee/<%= emp._id %>" method="get"
                                    style="display:inline;">
                                    <button class="btn btn-danger btn-sm">Delete</button>
                                </form>

                                <!-- 📝 Assign Task Button -->
                                <a href="/manager/assign-task?employeeId=<%= emp._id %>" class="btn btn-success btn-sm">
                                    Assign Task
                                </a>


                            </td>
                        </tr>
                        <% }) %>
                </tbody>
            </table>

            <h4 class="mt-5">➕ Add Employee</h4>
            <form action="/manager/add-employee" method="POST" class="mt-3">
                <div class="row">
                    <div class="col-md-4">
                        <input type="text" name="name" placeholder="Name" class="form-control" required>
                    </div>
                    <div class="col-md-4">
                        <input type="email" name="email" placeholder="Email" class="form-control" required>
                    </div>
                    <div class="col-md-3">
                        <input type="password" name="password" placeholder="Password" class="form-control" required>
                    </div>
                    <div class="col-md-1">
                        <button class="btn btn-primary w-100">Add</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <%- include('../../partials/footer') %>