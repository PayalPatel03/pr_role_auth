<%- include('../partials/header', { user: user }) %>

<div class="container d-flex justify-content-center mt-5">
  <div class="col-lg-8">
    <div class="card shadow-sm">
      <!-- Header -->
      <div class="card-header bg-purple text-white text-center">
        <h3 class="mb-0"><i class="bi bi-person-circle"></i> My Profile</h3>
      </div>

      <!-- Body -->
      <div class="card-body d-flex flex-column align-items-center">
        <div class="row w-100">
          <!-- Left Column -->
          <div class="col-md-4 text-center border-end d-flex flex-column align-items-center justify-content-center">
            <% if(user.image){ %>
              <img src="/uploads/<%= user.image %>" class="rounded-circle mb-3" width="150" height="150" style="object-fit:cover;">
            <% } else { %>
              <div class="rounded-circle mb-3 d-flex align-items-center justify-content-center" style="width:150px;height:150px;background-color:#0d6efd;color:white;font-size:60px;">
                <%= user.name.charAt(0).toUpperCase() %>
              </div>
            <% } %>
            <h4 class="mb-1"><%= user.name %></h4>
            <p class="text-muted mb-1"><%= user.role.toUpperCase() %></p>
            <p class="text-muted mb-0"><%= user.email %></p>
          </div>

          <!-- Right Column -->
          <div class="col-md-8 mt-3 mt-md-0">
            <div class="row mb-2">
              <div class="col-sm-4"><strong>Age:</strong></div>
              <div class="col-sm-8"><%= user.age || '-' %></div>
            </div>
            <div class="row mb-2">
              <div class="col-sm-4"><strong>Mobile:</strong></div>
              <div class="col-sm-8"><%= user.mobile || '-' %></div>
            </div>
            <div class="row mb-2">
              <div class="col-sm-4"><strong>Address:</strong></div>
              <div class="col-sm-8"><%= user.address || '-' %></div>
            </div>
            <div class="row mb-2">
              <div class="col-sm-4"><strong>Gender:</strong></div>
              <div class="col-sm-8"><%= user.gender || '-' %></div>
            </div>
            <div class="row mb-2">
              <div class="col-sm-4"><strong>Blood Group:</strong></div>
              <div class="col-sm-8"><%= user.bloodGroup || '-' %></div>
            </div>
          </div>
        </div>

        <!-- Buttons -->
        <div class="mt-4 d-flex justify-content-center w-100 gap-2">
          <a href="/<%= user.role %>/profile/edit" class="btn btn-purple">Edit Profile</a>
          <form action="/<%= user.role %>/profile/delete" method="POST" onsubmit="return confirm('Are you sure you want to delete your profile?');">
            <button type="submit" class="btn btn-danger">Delete Profile</button>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>

<style>
  .bg-purple { background-color: #7c5dfa; }
  .btn-purple { background-color: #7c5dfa; color: #fff; }
  .btn-purple:hover { background-color: #6a4cd9; color: #fff; }
</style>
